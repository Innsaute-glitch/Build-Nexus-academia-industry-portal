# PostgreSQL connection string. Use a dedicated least-privilege application role.
DATABASE_URL=
# At least 32 random bytes. Used for server-side security operations.
SESSION_SECRET=
# Required only while running the fictional development seed. Use a strong local-only value.
DEMO_PASSWORD=
# Required for the destructive fictional seed command; leave false otherwise.
ALLOW_DESTRUCTIVE_SEED=false
# Explicitly enables role-switch demo login in development. Never enable in production.
ENABLE_DEMO_LOGIN=false
# Optional public base URL used for generated links.
APP_URL=http://localhost:3000
